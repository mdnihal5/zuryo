{
    "name": "zuryo-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "typecheck": "tsc --noEmit",
        "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
        "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
        "test": "tsx test/run.ts",
        "stress": "nice -n 10 tsx scripts/stress.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
