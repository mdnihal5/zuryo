NODE_ENV=development
PORT=4000
# Supabase: use the pooled connection string (port 6543) or the direct one (5432)
DATABASE_URL=postgres://user:password@localhost:5432/zuryo
DATABASE_SSL=false
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_HOURS=12
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# Optional LLM path for the workout recommendation. Both must be set to enable it.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=


# Payment gateway, simulated locally (MockPay). Real gateway later: see docs/api.md, "Swapping MockPay for Cashfree".
MOCKPAY_ENABLED=true
# HMAC secret shared with the gateway for webhook signatures. Required in production, 16+ characters.
MOCKPAY_WEBHOOK_SECRET=replace-with-16-or-more-random-characters
# Where MockPay posts its webhook, and where the hosted checkout page (the web client) lives.
PUBLIC_API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
